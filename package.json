{
  "name": "gpt-tutorial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:code": "node scripts/generate-code-excerpts.mjs && node scripts/generate-full-code-page.mjs",
    "verify:code": "node scripts/verify-code-excerpts.mjs",
    "verify:story-map": "node scripts/verify-story-mappings.mjs",
    "verify:demonstrations": "node scripts/verify-demonstrations.mjs",
    "verify:offline": "node scripts/verify-service-worker.mjs",
    "verify:model": "uv run --with-requirements docs/code/requirements.txt --python 3.12 python scripts/verify_teaching_model.py",
    "record:generation-demo": "node scripts/record-generation-demo.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview --base /explain_ai/"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "d3": "^7.9.0",
    "highlight.js": "^11.11.1",
    "lenis": "^1.3.23",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "scrollama": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.2.4"
  }
}
